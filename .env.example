# 已有数据库：复制为项目根目录 .env 后填写连接；进程环境变量优先。
# 新建本机数据库：改用 scripts/init_local.py 生成配置，不要先复制本文件。
NOVEL_LENS_HOST=127.0.0.1
NOVEL_LENS_PORT=8000
NOVEL_LENS_LOG_LEVEL=INFO
# 业务接口需要已迁移的 PostgreSQL；密码须按 URL 规则编码。
# 填写用户自己的数据库。远程连接的 TLS 参数由该数据库的部署决定。
# NOVEL_LENS_DATABASE_URL=postgresql+psycopg://novel_lens:URL_ENCODED_PASSWORD@HOST:PORT/novel_lens
NOVEL_LENS_MAX_FILE_BYTES=67108864
NOVEL_LENS_MAX_REQUEST_BYTES=68157440
# 可选：全文与标注原文语义检索使用已验证的本机配置；模型服务需另行启动。
# NOVEL_LENS_EMBEDDING_CONFIG=embedding.local.toml
